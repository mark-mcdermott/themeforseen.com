---
import CloudLogo from '@/components/brand/CloudLogo.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Panel from '@/components/console/Panel.astro';
import { site } from '@/data/site';
---

{/* One plate with the header band: no edge on the right above the seam, where it runs on into the band. */}
<Panel region="brand" as="div" class="area-brand console:z-10" screws="tl bl br" plate="t l b">
	<a href="/" class="brand" aria-label={`${site.name}, home`}>
		<CloudLogo class="brand__cloud console:absolute console:top-15 console:left-40 h-97 w-auto" />
		<Wordmark class="brand__wordmark console:absolute console:top-22 console:left-151 h-36 w-auto" />
		<span class="brand__tagline lettering console:absolute console:top-62 console:left-155 fs-[12.3] tracking-[0.2em] whitespace-nowrap" data-probe="tagline">
			{site.tagline}
		</span>
	</a>
</Panel>

<style>
	.brand {
		position: absolute;
		inset: 0;
		color: var(--color-text);
	}

	/* The manufacturer's plate: the mark and the wordmark, the tagline where there is room for it */
	@media (max-width: 1279.98px) {
		.brand {
			position: static;
			display: grid;
			grid-template-columns: auto auto;
			grid-template-rows: auto auto;
			column-gap: calc(var(--u) * 14);
			align-items: center;
			padding: calc(var(--u) * 12) calc(var(--u) * 16) calc(var(--u) * 12) calc(var(--u) * 22);
			text-decoration: none;
		}

		.brand :global(.brand__cloud) {
			grid-row: 1 / 3;
			height: calc(var(--u) * 58);
		}

		.brand :global(.brand__wordmark) {
			align-self: end;
			height: calc(var(--u) * 26);
		}

		.brand__tagline {
			align-self: start;
			margin-top: calc(var(--u) * 5);
			font-size: calc(var(--u) * 10.5);
			letter-spacing: 0.16em;
		}
	}

	@media (max-width: 767.98px) {
		.brand__tagline {
			display: none;
		}

		.brand :global(.brand__cloud) {
			height: calc(var(--u) * 48);
		}

		.brand :global(.brand__wordmark) {
			align-self: center;
			height: calc(var(--u) * 19);
		}
	}
</style>
