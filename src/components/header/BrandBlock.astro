---
import CloudLogo from '@/components/brand/CloudLogo.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Panel from '@/components/console/Panel.astro';
import { site } from '@/data/site';
---

<Panel region="brand" as="div" class="area-brand z-10">
	<a href="/" class="brand" aria-label={`${site.name}, home`}>
		<CloudLogo class="absolute top-15 left-31 h-106 w-auto" />
		<Wordmark class="absolute top-22 left-151 h-36 w-auto" />
		<span class="lettering absolute top-62 left-155 fs-[12.3] tracking-[0.2em] whitespace-nowrap" data-probe="tagline">
			{site.tagline}
		</span>
	</a>
</Panel>

<style>
	.brand {
		position: absolute;
		inset: 0;
		color: var(--color-text);
	}
</style>
