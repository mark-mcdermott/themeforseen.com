---
/**
 * The synoptic chart behind the readouts: the contiguous states, isobars
 * round a high and a low, and a warm front, in the reference's composition.
 * The chart is the station's atmosphere, not a forecast.
 */
import map from '@/assets/map/contiguous-us.json';
import { centres, front, frontSymbols, isobar } from '@/lib/synoptic';

/** Where the map sits on the screen, in screen pixels: the west coast a little right of centre, the east running off the glass. */
const placement = { x: 205, y: 132, width: 360 };
const [, , mapWidth] = map.viewBox.split(' ').map(Number);
const mapScale = placement.width / mapWidth!;
const symbols = frontSymbols();
---

<svg class="chart" viewBox="0 0 498.5 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
	<g class="chart__map" transform={`translate(${placement.x} ${placement.y}) scale(${mapScale})`}>
		{map.states.map((state) => <path d={state.d} class="chart__state" />)}
		<path d={map.nation} class="chart__nation" />
	</g>

	<g class="chart__isobars">
		{
			centres.map((centre) => (
				<g>
					{centre.rings.map((radius) => (
						<path d={isobar(centre, radius)} class="chart__isobar" />
					))}
					<text x={centre.at[0]} y={centre.at[1]} class="chart__centre">
						{centre.kind}
					</text>
				</g>
			))
		}
	</g>

	<g class="chart__front">
		<path d={front.d} class="chart__front-line" />
		{
			symbols.map(({ at: [x, y], angle }) => (
				<path d={`M${-front.symbol} 0 A${front.symbol} ${front.symbol} 0 0 1 ${front.symbol} 0Z`} class="chart__front-symbol" transform={`translate(${x} ${y}) rotate(${angle})`} />
			))
		}
		<circle cx="262" cy="276" r="3" class="chart__station" />
		<circle cx="386" cy="222" r="2.6" class="chart__station" />
		<circle cx="446" cy="318" r="2.4" class="chart__station" />
	</g>

	<style>
		.chart__state {
			fill: none;
			stroke: var(--crt-trace);
			stroke-width: 1.4;
			stroke-opacity: 0.5;
			vector-effect: non-scaling-stroke;
		}

		.chart__nation {
			fill: rgb(255 255 255 / 0.025);
			stroke: var(--crt-phosphor);
			stroke-width: 1.3;
			stroke-opacity: 0.5;
			vector-effect: non-scaling-stroke;
		}

		.chart__isobar {
			fill: none;
			stroke: var(--crt-isobar);
			stroke-width: 1;
			stroke-opacity: 0.55;
		}

		.chart__centre {
			font-family: var(--font-label);
			font-size: 15px;
			font-weight: 500;
			fill: var(--crt-isobar);
			text-anchor: middle;
			dominant-baseline: central;
			paint-order: stroke;
			stroke: var(--crt-glass);
			stroke-width: 6;
		}

		.chart__front-line {
			fill: none;
			stroke: var(--crt-front);
			stroke-width: 2.6;
			stroke-linecap: round;
		}

		.chart__front-symbol {
			fill: var(--crt-front);
		}

		.chart__station {
			fill: var(--crt-front);
			opacity: 0.85;
		}
	</style>
</svg>

<style>
	.chart {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}
</style>
