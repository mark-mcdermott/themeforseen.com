---
/**
 * The CRT module, outermost layer first: label strip, faceplate, funnel,
 * recess, tube, and the sill beneath.
 *
 * The outlines are drawn once, in src/lib/crt.ts, and used twice: as the lines
 * the eye sees and as the shapes that cut each layer. Surfaces are HTML so the
 * readouts can be; lines, shadow and glare are one drawing laid over them.
 *
 * Whatever is put in the slot appears on the screen.
 */
import Panel from '@/components/console/Panel.astro';
import DayNightSwitch from '@/components/ui/DayNightSwitch.astro';
import { housing, outlinePath, outlines, place, type OutlineName } from '@/lib/crt';
import { uid } from '@/lib/uid';

const { module, label, faceplate, sill } = housing;

const names = Object.keys(outlines) as OutlineName[];
const cut = Object.fromEntries(names.map((name) => [name, uid(`crt-${name}`)])) as Record<OutlineName, string>;
const ids = { face: uid('crt-face'), rim: uid('crt-rim-light'), edge: uid('crt-edge-light'), glare: uid('crt-glare'), soften: uid('crt-soften') };

const layer = (name: OutlineName) => `${place(outlines[name], faceplate)};clip-path:url(#${cut[name]})`;
const drawn = (name: OutlineName) => outlinePath(outlines[name], faceplate);
---

<Panel region="crt" class="area-crt crt" screws="tl tr bl br" id="conditions" aria-label="Theme conditions">
	<div class="crt__part crt__label" data-region="crt-label" style={place(label, module)}>
		<i class="screw screw--dark crt__label-screw crt__label-screw--left" aria-hidden="true"></i>
		<p data-probe="crt-label">Theme conditions</p>
		<DayNightSwitch class="crt__switch" />
		<i class="screw screw--dark crt__label-screw crt__label-screw--right" aria-hidden="true"></i>
	</div>

	<div class="crt__part crt__faceplate" data-region="crt-faceplate" style={place(faceplate, module)}>
		<div class="crt__part crt__funnel" data-region="crt-rim" style={layer('rim')}></div>
		<div class="crt__part crt__recess" data-region="crt-aperture" style={layer('aperture')}></div>
		<div class="crt__part crt__tube" data-region="crt-glass" style={layer('glass')}>
			<div class="crt__screen"><slot /></div>
		</div>

		<svg class="crt__drawing" viewBox={`0 0 ${faceplate.width} ${faceplate.height}`} aria-hidden="true" focusable="false">
			<defs>
				{
					names.map((name) => (
						<clipPath id={cut[name]} clipPathUnits="objectBoundingBox">
							<path d={outlinePath(outlines[name])} transform={`scale(${1 / outlines[name].width} ${1 / outlines[name].height})`} />
						</clipPath>
					))
				}
				<clipPath id={ids.face}><path d={drawn('glass')}></path></clipPath>

				<linearGradient id={ids.rim} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#39433f"></stop>
					<stop offset="0.5" stop-color="#565f51"></stop>
					<stop offset="0.9" stop-color="#9fada6"></stop>
					<stop offset="1" stop-color="#b4c2bb"></stop>
				</linearGradient>
				<linearGradient id={ids.edge} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0.62" stop-color="#a9b9b3" stop-opacity="0"></stop>
					<stop offset="0.9" stop-color="#a9b9b3" stop-opacity="0.55"></stop>
					<stop offset="1" stop-color="#c3d0ca" stop-opacity="0.85"></stop>
				</linearGradient>
				<linearGradient id={ids.glare} x1="0" y1="0" x2="0.12" y2="1">
					<stop offset="0" stop-color="#dff7f4" stop-opacity="0.03"></stop>
					<stop offset="0.2" stop-color="#dff7f4" stop-opacity="0.015"></stop>
					<stop offset="0.45" stop-color="#dff7f4" stop-opacity="0"></stop>
				</linearGradient>
				<filter id={ids.soften} x="-10%" y="-10%" width="120%" height="120%">
					<feGaussianBlur stdDeviation="7"></feGaussianBlur>
				</filter>
			</defs>

			<g clip-path={`url(#${ids.face})`}>
				<path class="crt__shade" d={drawn('glass')} filter={`url(#${ids.soften})`}></path>
				<path d={drawn('glass')} fill={`url(#${ids.glare})`}></path>
			</g>

			<path class="crt__line" data-contour="glass" d={drawn('glass')} stroke="#000" stroke-opacity="0.5"></path>
			<path class="crt__line" data-contour="lip" d={drawn('lip')} stroke="var(--crt-lip)" stroke-width="1.6"></path>
			<path class="crt__line" data-contour="aperture" d={drawn('aperture')} stroke={`url(#${ids.edge})`} stroke-width="1.4"></path>
			<path class="crt__line" data-contour="rim" d={drawn('rim')} stroke={`url(#${ids.rim})`} stroke-width="1.5"></path>
		</svg>
	</div>

	<div class="crt__part crt__sill" data-region="crt-sill" style={place(sill, module)}></div>
</Panel>

<style>
	.crt__part {
		position: absolute;
		left: calc(var(--u) * var(--x));
		top: calc(var(--u) * var(--y));
		width: calc(var(--u) * var(--w));
		height: calc(var(--u) * var(--h));
	}

	/* ------------------------------------------------------- label strip */

	.crt__label {
		border-radius: calc(var(--u) * 4);
		background: linear-gradient(color-mix(in oklab, var(--crt-black) 80%, black), var(--crt-black) 45%);
		box-shadow:
			inset 0 calc(var(--u) * 1.5) calc(var(--u) * 2) rgb(0 0 0 / 0.7),
			0 var(--u) 0 var(--edge-hi);
		color: var(--crt-label-ink);
	}

	.crt__label p {
		position: absolute;
		top: calc(var(--u) * 3.5);
		left: calc(var(--u) * 20.4);
		font-family: var(--font-label);
		font-weight: 500;
		font-size: calc(var(--u) * 15);
		line-height: calc(var(--u) * 20);
		letter-spacing: 0.145em;
		word-spacing: calc(var(--u) * 2);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.crt__label-screw {
		--screw: calc(var(--u) * 7);

		top: calc(var(--u) * 10.5);
	}

	.crt__label-screw--left  { left: calc(var(--u) * 7); }
	.crt__label-screw--right { right: calc(var(--u) * 7); }

	.crt__label :global(.crt__switch) {
		position: absolute;
		top: 0;
		right: calc(var(--u) * 27);
		height: 100%;
	}

	/* --------------------------------------------------------- faceplate */

	/*
	 * Painted plate, lit from above: a bright top edge, the shadow of the panel
	 * it is set into above that, and its own shadow on the panel below.
	 */
	.crt__faceplate {
		border-radius: calc(var(--u) * 13);
		background: linear-gradient(var(--crt-faceplate) 82%, color-mix(in oklab, var(--crt-faceplate) 84%, black));
		box-shadow:
			inset 0 calc(var(--u) * 1.5) 0 var(--crt-edge),
			0 calc(var(--u) * -1.5) 0 rgb(0 0 0 / 0.85),
			0 calc(var(--u) * 2) calc(var(--u) * 5) rgb(30 18 4 / 0.5);
	}

	/* ------------------------------------------------------------ funnel */

	/*
	 * Four faces falling away to the tube, each catching the light differently:
	 * the top in shadow and darkest at its ends, the sides dimming as they go
	 * down, the bottom lit, and a sheen where the bottom meets each side. The
	 * faces meet on the diagonals, which from the middle lie 51.5 degrees
	 * either side of upright.
	 */
	.crt__funnel {
		background: conic-gradient(
			#011f20 0deg,
			#011a1b 25deg,
			#021312 43deg,
			#020a09 51.5deg,
			#152b28 62deg,
			#102120 90deg,
			#0e1c1c 119deg,
			#142423 124deg,
			#5e7070 128.5deg,
			#465a57 137deg,
			#546c68 180deg,
			#48605c 223deg,
			#708281 231.5deg,
			#1a2c29 236deg,
			#0f201e 241deg,
			#182a22 270deg,
			#1f3227 298deg,
			#030b0a 308.5deg,
			#011312 317deg,
			#011a1b 335deg,
			#011f20 360deg
		);
	}

	.crt__recess {
		background: #010303;
	}

	/* -------------------------------------------------------------- tube */

	.crt__tube {
		background: var(--crt-glass);
	}

	.crt__screen {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 62% 68% at 56% 40%, #045a5a, #034f50 28%, #023638 45%, #012527 60%, #012022 78%, #011d1f);
		color: var(--crt-phosphor);
	}

	/* ----------------------------------------------------------- drawing */

	.crt__drawing {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.crt__line {
		fill: none;
	}

	/* The bezel's shadow on the glass: a wide soft line about its edge, kept to the glass. */
	.crt__shade {
		fill: none;
		stroke: #000;
		stroke-width: 22;
		stroke-opacity: 0.42;
	}

	/* -------------------------------------------------------------- sill */

	.crt__sill {
		box-shadow: inset 0 var(--seam-w) 0 0 var(--seam);
	}
</style>
