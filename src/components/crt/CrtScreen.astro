---
/**
 * What the tube shows: who the station is, the conditions ThemeForseen has
 * set, and how large the collection is. Every figure is real. The conditions
 * follow the drawer; the counts are read from the package.
 *
 * Positions are the reference's, measured from the corner of the glass.
 */
import CloudLogo from '@/components/brand/CloudLogo.astro';
import CrtMap from '@/components/crt/CrtMap.astro';
import { site, station } from '@/data/site';
import { product } from '@/lib/product';

const counts = [
	{ label: 'Themes', value: product.counts.themes },
	{ label: 'Pairings', value: product.counts.pairings },
	{ label: 'Tags', value: product.counts.tags },
];
---

<div class="screen" data-crt-screen data-signal="acquiring">
	<CrtMap />

	<CloudLogo variant="phosphor" class="screen__cloud" />

	<div class="screen__clock">
		<p class="screen__date" data-clock="date">--- --- -- ----</p>
		<p class="screen__time">
			<span data-clock="time">--:--</span>
			<span class="screen__meridiem" data-clock="meridiem">--</span>
		</p>
	</div>

	<div class="screen__identity">
		<p class="screen__name">{site.name}</p>
		<p>Visual Exploration System</p>
		<p>{station.place}</p>
	</div>

	<section class="screen__conditions" aria-labelledby="screen-conditions">
		<h2 id="screen-conditions" class="screen__heading">Current<br />conditions</h2>

		<dl class="screen__readouts">
			<div>
				<dt>Palette</dt>
				<dd data-readout="palette">{product.theme}</dd>
			</div>
			<div>
				<dt>Type</dt>
				<dd data-readout="type">{product.heading} + {product.body}</dd>
			</div>
			<div>
				<dt>Mode</dt>
				<dd data-readout="mode">Day</dd>
			</div>
			<div>
				<dt>Signal</dt>
				<dd class="screen__signal">
					<span class="sr-only" data-readout="signal">Acquiring</span>
					<i></i><i></i><i></i><i></i>
				</dd>
			</div>
		</dl>
	</section>

	<section class="screen__exploration" aria-labelledby="screen-exploration">
		<h2 id="screen-exploration" class="screen__heading">Exploration conditions</h2>
		<p class="screen__status" data-readout="exploration">Standby</p>

		<dl class="screen__counts">
			{
				counts.map((count) => (
					<div>
						<dt>{count.label}</dt>
						<dd>{count.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<p class="screen__motto">Good design ahead.</p>
	<p class="screen__unit">{site.unit}</p>

	<i class="screen__scanlines" aria-hidden="true"></i>
	<i class="screen__noise" aria-hidden="true"></i>
</div>

<script>
	import { currentMode, watchConditions, type Conditions } from '@/scripts/conditions';

	const modes: Record<Conditions['mode'], string> = { day: 'Day', night: 'Night' };

	// Station time, whatever the visitor's clock says
	const stationTime = new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/Chicago',
		weekday: 'short',
		month: 'short',
		day: 'numeric',
		year: 'numeric',
		hour: 'numeric',
		minute: '2-digit',
		hour12: true,
	});

	function tick() {
		const parts = Object.fromEntries(stationTime.formatToParts(new Date()).map(({ type, value }) => [type, value]));
		const readings = {
			date: `${parts.weekday} ${parts.month} ${parts.day} ${parts.year}`.toUpperCase(),
			time: `${parts.hour}:${parts.minute}`,
			meridiem: parts.dayPeriod ?? '',
		};
		for (const [name, reading] of Object.entries(readings)) {
			for (const element of document.querySelectorAll(`[data-clock="${name}"]`)) element.textContent = reading;
		}
		setTimeout(tick, 60_000 - (Date.now() % 60_000));
	}

	tick();

	for (const screen of document.querySelectorAll<HTMLElement>('[data-crt-screen]')) {
		const show = (readout: string, reading: string) => {
			const element = screen.querySelector(`[data-readout="${readout}"]`);
			if (element && element.textContent !== reading) element.textContent = reading;
		};

		show('mode', modes[currentMode()]);

		watchConditions(({ palette, heading, body, mode, exploring, comparing, live }) => {
			show('palette', palette);
			show('type', `${heading} + ${body}`);
			show('mode', modes[mode]);
			show('exploration', comparing ? 'Comparing' : exploring ? 'Active' : 'Standby');
			show('signal', live ? 'Locked' : 'Acquiring');
			screen.dataset.signal = live ? 'locked' : 'acquiring';
		});
	}
</script>

<style>
	.screen {
		--rule: calc(var(--u) * 1.2) solid var(--crt-trace);
		--glow: color-mix(in oklab, var(--crt-phosphor) 55%, transparent);

		position: absolute;
		inset: 0;
		font-family: var(--font-label);
		font-size: calc(var(--u) * 11);
		line-height: 1;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--crt-phosphor);
		text-shadow: 0 0 calc(var(--u) * 5) var(--glow);
		animation: flicker 7s steps(1) infinite;
	}

	.screen > * {
		position: absolute;
	}

	/* Phosphor persistence: a slight unsteadiness, never more than two percent */
	@keyframes flicker {
		0%, 100% { opacity: 1; }
		11% { opacity: 0.986; }
		13% { opacity: 1; }
		37% { opacity: 0.992; }
		39% { opacity: 1; }
		71% { opacity: 0.983; }
		72% { opacity: 1; }
	}

	/* ------------------------------------------------------- chart, cloud */

	.screen :global(.chart) {
		filter: drop-shadow(0 0 calc(var(--u) * 3) var(--glow));
	}

	.screen :global(.chart__isobars) {
		animation: drift 110s ease-in-out infinite alternate;
	}

	.screen :global(.chart__front) {
		animation: sway 140s ease-in-out infinite alternate;
	}

	@keyframes drift {
		from { transform: translate(0, 0); }
		to { transform: translate(6px, -4px); }
	}

	@keyframes sway {
		from { transform: translate(0, 0); }
		to { transform: translate(-4px, 3px); }
	}

	/* Rendered by another component, so the child rule above does not reach it */
	.screen :global(.screen__cloud) {
		position: absolute;
		top: calc(var(--u) * 37);
		left: calc(var(--u) * 29);
		height: calc(var(--u) * 88);
		width: auto;
		filter: drop-shadow(0 0 calc(var(--u) * 4) var(--glow));
	}

	/* ------------------------------------------------------------- clock */

	.screen__clock {
		top: calc(var(--u) * 27);
		right: calc(var(--u) * 26);
		text-align: right;
	}

	.screen__date {
		font-size: calc(var(--u) * 11.5);
		letter-spacing: 0.07em;
	}

	.screen__time {
		margin-top: calc(var(--u) * 7);
		font-size: calc(var(--u) * 31);
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.screen__meridiem {
		display: inline-block;
		margin-left: calc(var(--u) * 3);
		vertical-align: top;
		font-size: calc(var(--u) * 11);
		font-weight: 400;
		letter-spacing: 0.06em;
	}

	/* ---------------------------------------------------------- identity */

	.screen__identity {
		top: calc(var(--u) * 57.5);
		left: calc(var(--u) * 127.5);
		display: grid;
		gap: calc(var(--u) * 6);
		color: color-mix(in oklab, var(--crt-phosphor) 90%, var(--crt-glass));
	}

	.screen__name {
		font-weight: 700;
		font-size: calc(var(--u) * 18);
		letter-spacing: 0.035em;
		color: var(--crt-phosphor);
	}

	/* -------------------------------------------------------- conditions */

	.screen__heading {
		font-weight: 500;
		font-size: calc(var(--u) * 13.5);
		line-height: calc(var(--u) * 14.7);
		letter-spacing: 0.07em;
	}

	.screen__conditions {
		top: calc(var(--u) * 137);
		left: calc(var(--u) * 17);
		width: calc(var(--u) * 146);
		border-top: var(--rule);
	}

	.screen__conditions .screen__heading {
		padding: calc(var(--u) * 7) calc(var(--u) * 2.5) calc(var(--u) * 8.2);
		border-bottom: var(--rule);
	}

	.screen__readouts {
		display: grid;
		gap: calc(var(--u) * 7);
		padding: calc(var(--u) * 7.3) calc(var(--u) * 2.5) 0;
	}

	.screen__readouts > div {
		display: grid;
		grid-template-columns: calc(var(--u) * 64.5) calc(var(--u) * 190);
		align-items: center;
		height: calc(var(--u) * 12.4);
	}

	.screen__readouts dt {
		font-weight: 500;
		font-size: calc(var(--u) * 12);
	}

	/* Readings are set in a plain face and in their own case, as the reference sets them. */
	.screen__readouts dd {
		overflow: hidden;
		font-family: var(--font-readout);
		font-size: calc(var(--u) * 12.6);
		line-height: calc(var(--u) * 16);
		letter-spacing: 0.01em;
		text-transform: none;
		text-overflow: ellipsis;
	}

	.screen__signal {
		display: flex;
		gap: calc(var(--u) * 4.3);
		padding-left: calc(var(--u) * 0.5);
	}

	.screen__signal i {
		width: calc(var(--u) * 10.7);
		height: calc(var(--u) * 10.7);
		border-radius: 50%;
		background: var(--crt-signal);
		opacity: 0.22;
		transition: opacity 0.4s;
	}

	[data-signal='locked'] .screen__signal i {
		opacity: 1;
	}

	[data-signal='locked'] .screen__signal i:nth-child(3) { transition-delay: 0.12s; }
	[data-signal='locked'] .screen__signal i:nth-child(4) { transition-delay: 0.24s; }
	[data-signal='locked'] .screen__signal i:nth-child(5) { transition-delay: 0.36s; }

	/* ------------------------------------------------------- exploration */

	.screen__exploration {
		top: calc(var(--u) * 278);
		left: calc(var(--u) * 17);
		width: calc(var(--u) * 320);
	}

	.screen__exploration .screen__heading {
		width: calc(var(--u) * 197.5);
		padding: calc(var(--u) * 6.5) calc(var(--u) * 3.2) calc(var(--u) * 6);
		border-top: var(--rule);
		font-size: calc(var(--u) * 13);
	}

	.screen__status {
		width: calc(var(--u) * 220);
		padding: calc(var(--u) * 9) calc(var(--u) * 4.5) 0;
		border-top: var(--rule);
		font-weight: 500;
		font-size: calc(var(--u) * 25);
		letter-spacing: 0.04em;
		color: var(--crt-readout);
	}

	.screen__counts {
		position: absolute;
		top: calc(var(--u) * 37);
		left: calc(var(--u) * 215.5);
		display: grid;
		gap: calc(var(--u) * 5);
		padding: calc(var(--u) * 5.5) 0 calc(var(--u) * 7) calc(var(--u) * 15);
		border-left: var(--rule);
	}

	.screen__counts > div {
		display: grid;
		grid-template-columns: calc(var(--u) * 62) calc(var(--u) * 40);
		height: calc(var(--u) * 11);
		font-weight: 500;
	}

	.screen__counts dd {
		text-align: right;
	}

	/* ------------------------------------------------------------ footer */

	.screen__motto,
	.screen__unit {
		font-size: calc(var(--u) * 11.5);
		color: var(--crt-signal);
	}

	.screen__motto {
		top: calc(var(--u) * 377);
		left: calc(var(--u) * 39.5);
	}

	.screen__unit {
		top: calc(var(--u) * 374.5);
		right: calc(var(--u) * 35.5);
	}

	/* ------------------------------------------------------------- glass */

	.screen__scanlines,
	.screen__noise {
		inset: 0;
		pointer-events: none;
	}

	.screen__scanlines {
		background: repeating-linear-gradient(rgb(0 0 0 / 0.16) 0 1px, transparent 1px 3px);
		mix-blend-mode: multiply;
	}

	.screen__noise {
		background: var(--grain) 0 0 / 180px 180px;
		mix-blend-mode: screen;
		opacity: 0.09;
		animation: noise 0.6s steps(3) infinite;
	}

	@keyframes noise {
		from { background-position: 0 0; }
		to { background-position: 180px 120px; }
	}

	/*
	 * On a phone the tube is a third of its desktop size, so the readouts are
	 * set in a larger unit than the housing and the secondary ones go: the
	 * station's subtitle, the date, the counts.
	 */
	@media (max-width: 767.98px) {
		.screen {
			--u: calc(100cqw / 470);
		}

		.screen__identity {
			top: calc(var(--u) * 36);
			left: calc(var(--u) * 108);
		}

		.screen__identity p:not(.screen__name),
		.screen__date,
		.screen__exploration {
			display: none;
		}

		.screen :global(.screen__cloud) {
			top: calc(var(--u) * 22);
			left: calc(var(--u) * 24);
			height: calc(var(--u) * 66);
		}

		.screen__clock {
			top: calc(var(--u) * 24);
			right: calc(var(--u) * 22);
		}

		.screen__time {
			margin-top: 0;
			font-size: calc(var(--u) * 24);
		}

		.screen__conditions {
			top: calc(var(--u) * 106);
		}

		.screen__motto {
			top: auto;
			bottom: calc(var(--u) * 16);
			left: calc(var(--u) * 34);
		}

		.screen__unit {
			top: auto;
			bottom: calc(var(--u) * 16);
			right: calc(var(--u) * 32);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.screen,
		.screen :global(.chart__isobars),
		.screen :global(.chart__front),
		.screen__noise {
			animation: none;
		}

		.screen__signal i {
			transition: none;
		}
	}
</style>
