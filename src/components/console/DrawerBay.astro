---
/**
 * The slot the ThemeForseen drawer slides into, shown stowed. The reference
 * only depicts the drawer open, so this state is a designed extension of it.
 */
import Panel from '@/components/console/Panel.astro';
import HardwareButton from '@/components/ui/HardwareButton.astro';
import Icon from '@/components/ui/Icon.astro';
---

<Panel region="bay" as="aside" class="area-bay bay" screws="tl tr bl br" aria-label="ThemeForseen drawer bay">
	<div class="bay__cavity">
		<span class="bay__rail bay__rail--top" aria-hidden="true"></span>
		<span class="bay__rail bay__rail--bottom" aria-hidden="true"></span>
		<span class="bay__connector" aria-hidden="true"></span>

		<p class="bay__label" aria-hidden="true">
			<strong>Service</strong>
			Drawer bay TF-01/B<br />
			No user-serviceable parts
		</p>

		<div class="bay__plate">
			<strong>Drawer bay</strong>
			<p class="panel-label">ThemeForseen<br />Color themes · Font pairings</p>
			<p class="panel-label bay__status">
				<i class="lamp lamp--green" data-bay-lamp aria-hidden="true"></i>
				<span data-bay-status>Stowed</span>
			</p>

			<HardwareButton tone="ink" class="bay__key" data-bay-open>
				Open drawer
				<Icon name="arrow" class="bay__arrow" />
			</HardwareButton>
		</div>
	</div>
</Panel>

<script>
	import { openDrawer, watchConditions } from '@/scripts/conditions';

	for (const key of document.querySelectorAll('[data-bay-open]')) {
		key.addEventListener('click', openDrawer);
	}

	watchConditions(({ exploring }) => {
		for (const status of document.querySelectorAll('[data-bay-status]')) {
			status.textContent = exploring ? 'Deployed' : 'Stowed';
		}
		for (const lamp of document.querySelectorAll('[data-bay-lamp]')) {
			lamp.classList.toggle('lamp--lit', exploring);
		}
	});
</script>
