---
import { Picture } from 'astro:assets';
import { siAstro, siNextdotjs, siReact, siSvelte, siVuedotjs } from 'simple-icons';

import CloudLogo from '@/components/brand/CloudLogo.astro';
import Panel from '@/components/console/Panel.astro';
import Icon from '@/components/ui/Icon.astro';

import panorama from '@/assets/photos/desert-panorama.webp';

const stacks = [
	{ name: 'React', path: siReact.path, colour: 'var(--mark-react)' },
	{ name: 'Next.js', path: siNextdotjs.path },
	{ name: 'Astro', path: siAstro.path },
	{ name: 'Vue', path: siVuedotjs.path, colour: 'var(--mark-vue)' },
	{ name: 'Svelte', path: siSvelte.path },
];
---

<div class="area-strip strip">
	<Panel region="strip-stack" as="div" class="stack-module" screws="tl tr bl br">
		<p class="stack-label lettering console:absolute console:top-25 console:left-35 fs-[12.3] lh-[15.5] tracking-[0.02em]" data-probe="stack-label">Works with<br />any stack</p>

		<ul class="stacks console:absolute console:top-17 console:left-134">
			{
				stacks.map((stack) => (
					<li>
						<svg viewBox="0 0 24 24" class="size-26" fill="currentColor" style={stack.colour ? `color:${stack.colour}` : undefined} aria-hidden="true">
							<path d={stack.path} />
						</svg>
						<span>{stack.name}</span>
					</li>
				))
			}
			<li>
				<Icon name="burst" class="size-26 scale-[0.62]" />
				<span>Vanilla</span>
			</li>
		</ul>
	</Panel>

	<Panel region="strip-photo" as="div" class="photo-module">
		<Picture
			src={panorama}
			alt="Desert under a bank of cloud"
			formats={['avif', 'webp']}
			widths={[240, 480, 720]}
			sizes="(min-width: 1280px) 13vw, 60vw"
			class="panorama"
			loading="lazy"
		/>
		<p class="same-site lettering console:absolute console:top-14 console:left-239 fs-[12.3] lh-[16.25] tracking-[0.015em]" data-probe="same-site">Same site.<br />Different<br />conditions.</p>
	</Panel>

	{/* The badge is one object: vents, the mark, the motto. It stays whole or it goes. */}
	<Panel region="strip-badge" as="div" class="badge-module" screws="tl tr bl br">
		<div class="badge">
			{/* Set 4 above the reference, whose motto runs into the plate's lower edge */}
			<i class="vents console:absolute console:top-13 console:left-14 h-40 w-53" aria-hidden="true"></i>
			<i class="vents console:absolute console:top-13 console:left-154 h-40 w-53" aria-hidden="true"></i>
			<CloudLogo variant="outline" class="badge__cloud console:absolute console:top-9.5 console:left-90 h-40 w-auto opacity-80" />
			<p class="badge__motto lettering console:absolute console:top-54 console:left-12 console:w-full text-center fs-11 tracking-[0.06em]" data-probe="badge">Good design ahead.</p>
		</div>
	</Panel>
</div>

<style>
	.stacks {
		display: flex;
		gap: calc(var(--u) * 28.5);
		color: var(--color-text);
	}

	.stacks li {
		display: grid;
		justify-items: center;
		gap: calc(var(--u) * 7);
		width: calc(var(--u) * 26);
	}

	.stacks span {
		font-family: var(--font-body);
		font-size: calc(var(--u) * 9.6);
		line-height: 1;
		white-space: nowrap;
	}

	.strip :global(.panorama) {
		position: absolute;
		top: calc(var(--u) * 4);
		left: calc(var(--u) * 17);
		width: calc(var(--u) * 191);
		height: calc(var(--u) * 68);
		border-radius: calc(var(--u) * 3);
		object-fit: cover;
		filter: grayscale(1) contrast(1.35) brightness(0.72);
	}

	/*
	 * Tablet: the marks on the left; the panorama and its line together on
	 * the right, against the right edge; the badge whole on a row of its own.
	 */
	@media (max-width: 1279.98px) {
		.stack-module {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: calc(var(--u) * 16) calc(var(--u) * 24);
			padding: calc(var(--u) * 16) calc(var(--u) * 24);
		}

		.stacks {
			flex-wrap: wrap;
			gap: calc(var(--u) * 16) calc(var(--u) * 22);
		}

		.photo-module {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: calc(var(--u) * 18);
			padding: calc(var(--u) * 10) calc(var(--u) * 24);
		}

		.strip :global(.panorama) {
			position: static;
			flex: none;
		}

		.badge-module {
			display: grid;
			place-items: center;
			padding: calc(var(--u) * 14) calc(var(--u) * 24);
		}

		.badge {
			position: relative;
			display: grid;
			grid-template-columns: auto auto auto;
			grid-template-areas:
				'vent-a cloud vent-b'
				'motto  motto motto';
			align-items: center;
			justify-items: center;
			column-gap: calc(var(--u) * 22);
			width: calc(var(--u) * 219);
		}

		.badge .vents {
			width: calc(var(--u) * 53);
			height: calc(var(--u) * 40);
		}

		.badge .vents:first-child { grid-area: vent-a; }
		.badge .vents:nth-child(2) { grid-area: vent-b; }
		.badge :global(.badge__cloud) { grid-area: cloud; }

		.badge__motto {
			grid-area: motto;
			margin-top: calc(var(--u) * 4);
		}
	}

	@media (min-width: 768px) and (max-width: 1279.98px) {
		.strip {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'stack photo'
				'badge badge';
		}

		.stack-module { grid-area: stack; }
		.photo-module { grid-area: photo; }
		.badge-module { grid-area: badge; }
	}

	/* Phone: the marks, then the badge; the panorama is left out */
	@media (max-width: 767.98px) {
		.strip {
			grid-template-columns: minmax(0, 1fr);
		}

		.photo-module {
			display: none;
		}
	}
</style>
