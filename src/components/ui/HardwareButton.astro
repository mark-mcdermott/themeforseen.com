---
import type { HTMLAttributes } from 'astro/types';

type Tone = {
	/** primary: the theme's primary. ink: the header's black key. plain: outlined. */
	tone?: 'primary' | 'ink' | 'plain';
};

/** With an href it goes somewhere; without one it does something. */
type Props = (HTMLAttributes<'a'> & { href: string } & Tone) | (HTMLAttributes<'button'> & { href?: never } & Tone);

const { tone = 'primary', class: className, ...rest } = Astro.props;
const classes = ['key', `key--${tone}`, className];
---

{
	'href' in rest && rest.href !== undefined ? (
		<a class:list={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type="button" class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
			<slot />
		</button>
	)
}

<style>
	.key {
		--key-edge:
			inset 0 var(--u) 0 rgb(255 255 255 / 0.22),
			inset 0 calc(var(--u) * -1.5) 0 rgb(0 0 0 / 0.28),
			0 var(--u) calc(var(--u) * 1.5) rgb(0 0 0 / 0.3);

		display: inline-flex;
		align-items: center;
		border-radius: calc(var(--u) * 6);
		box-shadow: var(--key-edge);
		font-family: var(--font-body);
		font-weight: 500;
		letter-spacing: -0.01em;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition:
			filter 0.15s,
			transform 0.15s;
	}

	.key:hover {
		filter: brightness(1.08);
	}

	.key:active {
		transform: translateY(calc(var(--u) * 1));
		box-shadow:
			inset 0 var(--u) 0 rgb(255 255 255 / 0.1),
			inset 0 calc(var(--u) * -1) 0 rgb(0 0 0 / 0.2);
	}

	.key--primary {
		background: var(--color-primary);
		color: var(--on-primary);
	}

	.key--ink {
		background: var(--color-text);
		color: var(--color-bg);
	}

	.key--plain {
		background: var(--color-card-bg);
		color: var(--color-text);
		box-shadow: inset 0 0 0 calc(var(--u) * 1.5) var(--seam), var(--key-edge);
	}
</style>
