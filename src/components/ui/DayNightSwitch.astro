---
/**
 * The station's DAY / NIGHT switch. Where it is thrown follows --night, which
 * is on the page before any script runs.
 */
import SlideSwitch from '@/components/ui/SlideSwitch.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<day-night-switch class:list={['switch', className]}>
	<SlideSwitch legend="Conditions" off={{ value: 'day', label: 'Day' }} on={{ value: 'night', label: 'Night' }} />
</day-night-switch>

<script>
	import { currentMode, setMode, watchConditions, type Conditions } from '@/scripts/conditions';

	type Mode = Conditions['mode'];

	class DayNightSwitch extends HTMLElement {
		connectedCallback() {
			this.show(currentMode());
			watchConditions(({ mode }) => this.show(mode));

			this.addEventListener('change', (event) => {
				const { checked, value } = event.target as HTMLInputElement;
				if (checked) setMode(value as Mode);
			});

			this.querySelector('.switch__track')?.addEventListener('click', () => {
				setMode(currentMode() === 'night' ? 'day' : 'night');
			});
		}

		private show(mode: Mode) {
			const legend = this.querySelector<HTMLInputElement>(`input[value="${mode}"]`);
			if (legend) legend.checked = true;
		}
	}

	customElements.define('day-night-switch', DayNightSwitch);
</script>

<style>
	.switch {
		display: block;
		--thrown: var(--night);
	}
</style>
