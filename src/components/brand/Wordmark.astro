---
/** The name, as outlines. See scripts/outline-wordmark.mjs. */
import wordmark from '@/assets/brand/wordmark.json';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox={`0 0 ${wordmark.width} ${wordmark.height}`} class={className} role="img" aria-label="ThemeForseen">
	<path d={wordmark.d} fill="currentColor"></path>
</svg>
