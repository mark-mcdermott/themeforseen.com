---
import '@/styles/global.css';

import ReferenceOverlay from '@/components/dev/ReferenceOverlay.astro';
import headlineFace from '@/assets/fonts/geist-latin.woff2?url';
import { factory, factoryStyles } from '@/lib/product';
import { CONDITIONS_KEY } from '@/scripts/conditions';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const card = new URL('/social-card.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="preload" href={headlineFace} as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" content="#022a2e" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ThemeForseen" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={card} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The TF-01 Visual Exploration Unit: a cream instrument console with a CRT weather display and the words See what fits." />
		<meta name="twitter:card" content="summary_large_image" />

		<style is:inline set:html={factoryStyles}></style>

		{/* Before the first paint, so a returning visitor never sees the factory theme in place of their own. */}
		<script is:inline define:vars={{ key: CONDITIONS_KEY }}>
			try {
				const remembered = JSON.parse(localStorage.getItem(key));
				if (remembered) document.documentElement.style.cssText = remembered.style;
			} catch {
				// Storage is unavailable or unreadable: the factory theme stands.
			}
		</script>
	</head>

	<body>
		<div class="field">
			<div class="console-frame">
				<slot />
			</div>
		</div>

		<theme-forseen default-theme={factory.theme} default-fonts={factory.fonts}></theme-forseen>

		{import.meta.env.DEV && <ReferenceOverlay />}

		<script>
			import { start } from '@/scripts/conditions';

			start();
		</script>
	</body>
</html>
